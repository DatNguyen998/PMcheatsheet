# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).

# Used by the running app (client + server). Safe to expose — Row Level
# Security restricts the anon key to read-only access. See docs/database-schema.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used ONLY by scripts/seed.ts (never read by the app itself, never exposed
# to the browser). Keep this secret — it bypasses Row Level Security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
